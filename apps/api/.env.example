DATABASE_URL="postgresql://postgres@localhost:5432/classnevis?schema=public"
PORT=4000
# کلید OpenRouter خود را اینجا قرار دهید
OPENROUTER_API_KEY=""
TRANSCRIBE_MODEL="elevenlabs/scribe-v2"
# زبان کلاس برای مدل‌های گفتار‌به‌متن (خالی = تشخیص خودکار)
TRANSCRIBE_LANGUAGE="fa"
NOTE_MODEL="google/gemini-3.8-flash"
STORAGE_DIR="./storage"
# Cloudflare R2 (S3-compatible) for audio files
CF_ACCESS_KEY_ID=""
CF_SECRET_ACCESS_KEY=""
# optional: CF_R2_ENDPOINT (default: account endpoint), CF_R2_BUCKET (default: classnevis)
